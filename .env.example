# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
# Obtenerlo en analytics.google.com → Admin → Property Settings
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (opcional)
# Obtenerlo en search.google.com/search-console al agregar la propiedad
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ─── Contador de escaneos de QR (/q/<slug>) ───
# Upstash Redis, plan free. Crear la base en console.upstash.com y copiar las
# credenciales REST. Sin esto la redirección funciona igual, pero el contador
# queda en memoria y se pierde en cada deploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Token para abrir el panel: clicfit.ar/qr/<slug>?token=<esto>
# Cualquier string largo al azar. Si queda vacío, en producción el panel da 404.
QR_PANEL_TOKEN=

# Sal del hash con el que se cuentan visitantes únicos sin guardar IPs.
# Opcional, pero conviene ponerle un valor propio. Cambiarlo resetea los únicos.
QR_HASH_SALT=
